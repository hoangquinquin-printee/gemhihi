<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Gemini Photo Digitizer v9.0 Windows 10/11 VCL Runtime Color Palette (sampled from Ảnh 1–5) -->
    <Color x:Key="GeminiBtnFaceColor">#F0F0F0</Color>
    <Color x:Key="GeminiDialogFaceColor">#F0F0F0</Color>
    <Color x:Key="GeminiWorkspaceGrayColor">#808080</Color>
    <Color x:Key="GeminiBevelLightColor">#FFFFFF</Color>
    <Color x:Key="GeminiBevelDarkColor">#A0A0A0</Color>
    <Color x:Key="GeminiBevelDeepDarkColor">#696969</Color>
    <Color x:Key="GeminiSelectedBgColor">#E2E2E2</Color>
    <Color x:Key="GeminiTitleBlueStart">#0A246A</Color>
    <Color x:Key="GeminiTitleBlueEnd">#A6CAF0</Color>

    <SolidColorBrush x:Key="GeminiBtnFaceBrush" Color="{StaticResource GeminiBtnFaceColor}" />
    <SolidColorBrush x:Key="GeminiDialogFaceBrush" Color="{StaticResource GeminiDialogFaceColor}" />
    <SolidColorBrush x:Key="GeminiWorkspaceGrayBrush" Color="{StaticResource GeminiWorkspaceGrayColor}" />
    <SolidColorBrush x:Key="GeminiBevelLightBrush" Color="{StaticResource GeminiBevelLightColor}" />
    <SolidColorBrush x:Key="GeminiBevelDarkBrush" Color="{StaticResource GeminiBevelDarkColor}" />
    <SolidColorBrush x:Key="GeminiBevelDeepDarkBrush" Color="{StaticResource GeminiBevelDeepDarkColor}" />
    <SolidColorBrush x:Key="GeminiSelectedBgBrush" Color="{StaticResource GeminiSelectedBgColor}" />
    <SolidColorBrush x:Key="GeminiTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="GeminiDisabledTextBrush" Color="#808080" />
    <SolidColorBrush x:Key="GeminiInactivePropEditBrush" Color="#9B9B9B" />

    <!-- Classic VCL Toolbar Separator (TTBSeparatorItem) -->
    <Style x:Key="GeminiToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="3,2,3,2" />
        <Setter Property="Background" Value="#A0A0A0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Classic VCL Flat Toolbar Button (TTBItem) -->
    <Style x:Key="GeminiToolbarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0E8F6" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#316AC5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C1D2EE" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#316AC5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic VCL Toggle Toolbar Button -->
    <Style x:Key="GeminiToolbarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0E8F6" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#316AC5" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E4E4E4" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#808080" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D8D8D8" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#606060" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Split-Button Dropdown Arrow Part (TTBItem DropdownCombo=True) -->
    <Style x:Key="GeminiToolbarDropArrowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Polygon x:Name="ArrowPoly"
                                 Points="0,0 5,0 2.5,3"
                                 Fill="#101010"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0E8F6" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#316AC5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ArrowPoly" Property="Fill" Value="#969696" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic VCL Sunken TextBox (TEdit / TEditNumericT) -->
    <Style x:Key="GeminiClassicTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Tahoma, MS Sans Serif" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Padding" Value="2,1,2,1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="BorderBrush" Value="#808080" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#808080"
                            BorderThickness="1,1,0,0"
                            SnapsToDevicePixels="True">
                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                            <Border BorderBrush="#696969" BorderThickness="1,1,0,0">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="1,0,1,0"
                                              VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Classic VCL Button (TButton / TBitBtnWithColor) -->
    <Style x:Key="GeminiClassicButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Tahoma, MS Sans Serif" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Background" Value="{StaticResource GeminiBtnFaceBrush}" />
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#FFFFFF"
                            BorderThickness="1,1,0,0"
                            SnapsToDevicePixels="True">
                        <Border x:Name="Inner"
                                BorderBrush="#696969"
                                BorderThickness="0,0,1,1">
                            <Border BorderBrush="#A0A0A0" BorderThickness="0,0,1,1">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="#E6E6E6" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#696969" />
                            <Setter TargetName="Inner" Property="BorderBrush" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
