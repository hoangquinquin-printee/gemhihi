<Window x:Class="PatternDigitizerPro.UI.Views.ExportInvestronicaDbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export to Investronica database"
        Width="323"
        Height="508"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#DCDAD0"
        FontFamily="Tahoma, MS Sans Serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas Background="#DCDAD0">
        <TextBlock Canvas.Left="8" Canvas.Top="8" Text="Piece List:" />

        <ListBox Canvas.Left="0" Canvas.Top="24"
                 Width="313" Height="337"
                 Background="#FFFFFF"
                 BorderBrush="#808080">
            <ListBoxItem Content="Piece 1" />
            <ListBoxItem Content="Piece 2" />
            <ListBoxItem Content="Piece 3" IsSelected="True" />
            <ListBoxItem Content="Piece 4" />
        </ListBox>

        <GroupBox Canvas.Left="0" Canvas.Top="368"
                  Width="313" Height="73"
                  BorderBrush="#A0A0A0">
            <Canvas>
                <TextBlock Canvas.Left="8" Canvas.Top="12"
                           Text="Investronica DB export is deferred to Phase 2."
                           Foreground="#505050" />
            </Canvas>
        </GroupBox>

        <Button Canvas.Left="160" Canvas.Top="448" Width="75" Height="25"
                Content="OK"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="OkBtn_Click" />
        <Button Canvas.Left="240" Canvas.Top="448" Width="75" Height="25"
                Content="Cancel"
                IsCancel="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="CancelBtn_Click" />
    </Canvas>
</Window>
