<Window x:Class="PatternDigitizerPro.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PatternDigitizerPro.UI.Controls"
        Title="About"
        Width="500"
        Height="315"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#DCDAD0"
        FontFamily="Tahoma, MS Sans Serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas Background="#DCDAD0">
        <!-- Sunken Panel1 (Left=8, Top=8, Width=281, Height=161) -->
        <Border Canvas.Left="8" Canvas.Top="8"
                Width="469" Height="235"
                Background="#DCDAD0"
                BorderBrush="#808080"
                BorderThickness="1">
            <Canvas>
                <controls:GeminiToolbarIcon Kind="AppLogo"
                                            Canvas.Left="12" Canvas.Top="12"
                                            Width="48" Height="48" />
                <TextBlock Canvas.Left="76" Canvas.Top="16" Text="GEMHIHI — Pattern Digitizer" FontWeight="Bold" FontSize="13" />
                <TextBlock Canvas.Left="76" Canvas.Top="44" Text="Engineered by HOÀNG | 0931 325 512" />
                <TextBlock Canvas.Left="12" Canvas.Top="82" Width="440" Text="Precision Built. Professionally Protected." FontWeight="SemiBold" />
                <TextBlock Canvas.Left="12" Canvas.Top="112" Width="440" Text="© 2026 HOÀNG. All Rights Reserved." />
                <TextBlock Canvas.Left="12" Canvas.Top="138" Width="440" TextWrapping="Wrap"
                           Text="Unauthorized cracking, modification or redistribution is strictly prohibited." />
            </Canvas>
        </Border>

        <Button Canvas.Left="207" Canvas.Top="254"
                Width="65" Height="33"
                Content="OK"
                IsDefault="True"
                IsCancel="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="OkBtn_Click" />
    </Canvas>
</Window>
