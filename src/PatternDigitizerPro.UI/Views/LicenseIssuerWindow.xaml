<Window x:Class="PatternDigitizerPro.UI.Views.LicenseIssuerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gemhihi Key Issuer" Width="620" Height="470" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock FontSize="25" FontWeight="Bold" Foreground="#063B65" Text="gemhihi Key Issuer"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,18" TextWrapping="Wrap" Text="Create a signed, machine-bound trial or subscription license. Keep the private key only on this issuer computer."/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Customer name"/><TextBox Grid.Column="1" x:Name="CustomerBox"/></Grid>
        <Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Customer Machine ID"/><TextBox Grid.Column="1" x:Name="MachineIdBox" CharacterCasing="Upper"/></Grid>
        <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="Expiry date"/><DatePicker Grid.Column="1" x:Name="ExpiryPicker"/><TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="DimGray" Text="License stops at 23:59 UTC"/></Grid>
        <StackPanel Grid.Row="5" Margin="0,15,0,0"><TextBlock FontWeight="Bold" Text="RSA private key (.pem)"/><DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Content="Browse..." Click="BrowseKey_Click"/><TextBox x:Name="KeyPathBox"/></DockPanel><TextBlock FontWeight="Bold" Text="Output license file"/><DockPanel Margin="0,4,0,0"><Button DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Content="Save as..." Click="SaveAs_Click"/><TextBox x:Name="OutputPathBox"/></DockPanel></StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Width="145" Content="Create license" IsDefault="True" Click="CreateLicense_Click"/><Button Width="85" Margin="8,0,0,0" Content="Close" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
