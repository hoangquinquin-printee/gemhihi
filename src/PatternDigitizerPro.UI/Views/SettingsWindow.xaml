<Window x:Class="PatternDigitizerPro.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings Gemini Photo Digitizer"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        FontFamily="Tahoma, MS Sans Serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas Width="538" Height="362" Background="#F0F0F0">
        <!-- SettingsPageControl (Left=0, Top=0, Width=538, Height=321) -->
        <TabControl x:Name="SettingsTabControl"
                    Canvas.Left="0" Canvas.Top="0"
                    Width="538" Height="321"
                    Background="#F0F0F0"
                    BorderBrush="#A0A0A0"
                    SelectedIndex="0">

            <!-- TAB 0: General settings (Matches Ảnh 3 & TSettingsFrm.GeneralSettingsTS 1:1) -->
            <TabItem Header="General settings" Padding="4,2">
                <Canvas Background="#F0F0F0">
                    <TextBlock Canvas.Left="8" Canvas.Top="16" Text="Application language" />
                    <ComboBox Canvas.Left="120" Canvas.Top="12" Width="113" Height="21" SelectedIndex="0">
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="Romana" />
                        <ComboBoxItem Content="Francais" />
                        <ComboBoxItem Content="Deutsch" />
                        <ComboBoxItem Content="Espanol" />
                    </ComboBox>

                    <TextBlock Canvas.Left="8" Canvas.Top="44" Text="Measurement unit" />
                    <ComboBox Canvas.Left="120" Canvas.Top="40" Width="113" Height="21" SelectedIndex="2">
                        <ComboBoxItem Content="mm" />
                        <ComboBoxItem Content="inch" />
                        <ComboBoxItem Content="cm" />
                    </ComboBox>

                    <TextBlock Canvas.Left="8" Canvas.Top="72" Text="Dimensions precision" />
                    <TextBox Canvas.Left="120" Canvas.Top="68" Width="41" Height="21" Text="2" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                    <TextBlock Canvas.Left="8" Canvas.Top="100" Text="Picture directory:" />
                    <TextBox Canvas.Left="120" Canvas.Top="96" Width="369" Height="21" Text="d:\pictures\" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                    <Button Canvas.Left="496" Canvas.Top="96" Width="25" Height="21" Content="..." Style="{StaticResource GeminiClassicButtonStyle}" />

                    <TextBlock Canvas.Left="272" Canvas.Top="18" Text="Zoom level magnifier" />
                    <Slider Canvas.Left="381" Canvas.Top="16" Width="130" Height="18" Minimum="0" Maximum="100" Value="82" />

                    <TextBlock Canvas.Left="272" Canvas.Top="42" Text="Zoom step:" />
                    <Slider Canvas.Left="381" Canvas.Top="40" Width="130" Height="18" Minimum="5" Maximum="50" Value="12" />

                    <!-- GroupBox2: Save settings: (Left=8, Top=120, Width=257, Height=129) -->
                    <GroupBox Header="Save settings:"
                              Canvas.Left="8" Canvas.Top="120"
                              Width="257" Height="129"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <RadioButton x:Name="KeepImagesRadio" Canvas.Left="12" Canvas.Top="6" Content="Keep the images" IsChecked="True" GroupName="SaveHist" />
                            <RadioButton x:Name="DeleteCapturingRadio" Canvas.Left="12" Canvas.Top="30" Content="Delete after capturing" GroupName="SaveHist" />
                            <RadioButton x:Name="DeleteAfterDaysRadio" Canvas.Left="12" Canvas.Top="54" Content="Delete after" GroupName="SaveHist" />
                            <TextBox Canvas.Left="130" Canvas.Top="50" Width="41" Height="21" Text="20" IsEnabled="False" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="178" Canvas.Top="54" Text="days" />
                            <Button Canvas.Left="106" Canvas.Top="82" Width="123" Height="25"
                                    Content="Delete all pictures"
                                    Style="{StaticResource GeminiClassicButtonStyle}" />
                        </Canvas>
                    </GroupBox>

                    <!-- GroupBox3: Pictures name (Left=272, Top=120, Width=241, Height=81) -->
                    <GroupBox Header="Pictures name"
                              Canvas.Left="272" Canvas.Top="120"
                              Width="241" Height="81"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <RadioButton Canvas.Left="6" Canvas.Top="4" Content="Date&amp;Time" IsChecked="True" GroupName="PicNameMode" />
                            <RadioButton Canvas.Left="6" Canvas.Top="20" Content="Name &amp; Index" GroupName="PicNameMode" />
                            <TextBlock Canvas.Left="12" Canvas.Top="42" Text="Name:" />
                            <TextBox Canvas.Left="50" Canvas.Top="38" Width="121" Height="21" Text="Picture" IsEnabled="False" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                        </Canvas>
                    </GroupBox>

                    <CheckBox Canvas.Left="8" Canvas.Top="261" Content="Save only selected patterns" />
                </Canvas>
            </TabItem>

            <!-- TAB 1: Camera settings / Calibration (Matches Ảnh 4 & TSettingsFrm.CameraCalibrationTS 1:1) -->
            <TabItem Header="Camera settings / Calibration" Padding="4,2">
                <Canvas Background="#F0F0F0">
                    <GroupBox Header="Camera"
                              Canvas.Left="5" Canvas.Top="5"
                              Width="220" Height="50"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <Button Canvas.Left="8" Canvas.Top="4" Width="105" Height="25"
                                    Content="Camera settings"
                                    Click="CameraSettingsBtn_Click"
                                    Style="{StaticResource GeminiClassicButtonStyle}" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Scaner"
                              Canvas.Left="5" Canvas.Top="61"
                              Width="220" Height="76"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <Button Canvas.Left="8" Canvas.Top="5" Width="105" Height="25"
                                    Content="Select scaner"
                                    Style="{StaticResource GeminiClassicButtonStyle}" />
                            <CheckBox Canvas.Left="8" Canvas.Top="38" Content="Auto pixels per inch" IsChecked="True" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Calibration"
                              Canvas.Left="232" Canvas.Top="5"
                              Width="289" Height="276"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <CheckBox x:Name="UseGridCalibrationCheck"
                                      Canvas.Left="8" Canvas.Top="12"
                                      Content="Use grid calibration"
                                      IsChecked="True"
                                      Checked="UseGridCalibrationCheck_Changed"
                                      Unchecked="UseGridCalibrationCheck_Changed" />
                            <Button Canvas.Left="196" Canvas.Top="4"
                                    Width="75" Height="25"
                                    Content="Calibrate"
                                    Style="{StaticResource GeminiClassicButtonStyle}"
                                    Click="OpenCalibrationBtn_Click" />

                            <RadioButton x:Name="CalibByDimRadio"
                                         Canvas.Left="8" Canvas.Top="50"
                                         Content="Calibrate by dimensions"
                                         IsEnabled="False"
                                         GroupName="CalibMode" />
                            <TextBlock Canvas.Left="8" Canvas.Top="74" Text="Grid horizontal size:" />
                            <TextBox x:Name="GridHorizSizeBox" Canvas.Left="156" Canvas.Top="70" Width="49" Height="21" Text="0" IsEnabled="False" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="216" Canvas.Top="74" Text="cm" />

                            <TextBlock Canvas.Left="8" Canvas.Top="98" Text="Grid vertical size:" />
                            <TextBox x:Name="GridVertSizeBox" Canvas.Left="156" Canvas.Top="94" Width="49" Height="21" Text="0" IsEnabled="False" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="216" Canvas.Top="98" Text="cm" />

                            <RadioButton x:Name="CalibByResRadio"
                                         Canvas.Left="8" Canvas.Top="124"
                                         Content="Calibrate by resolution"
                                         IsChecked="True"
                                         IsEnabled="False"
                                         GroupName="CalibMode" />
                            <TextBlock Canvas.Left="8" Canvas.Top="148" Text="Horizontal pixels per inch:" />
                            <TextBox x:Name="DpiHorizBox" Canvas.Left="156" Canvas.Top="140" Width="118" Height="21" Text="0" IsEnabled="False" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="172" Text="Vertical pixels per inch:" />
                            <TextBox x:Name="DpiVertBox" Canvas.Left="156" Canvas.Top="164" Width="118" Height="21" Text="0" IsEnabled="False" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <CheckBox x:Name="RestrictRoiCheck"
                                      Canvas.Left="8" Canvas.Top="202"
                                      Content="Detect strictly inside ROI box (Mode B)"
                                      IsEnabled="False" />
                        </Canvas>
                    </GroupBox>
                </Canvas>
            </TabItem>

            <!-- TAB 2: Interpretation settings (Matches gemini_full_ui.png 1:1) -->
            <TabItem Header="Interpretation settings" Padding="4,2">
                <Canvas Background="#F0F0F0">
                    <!-- Corners settings -->
                    <GroupBox Header="Corners settings"
                              Canvas.Left="5" Canvas.Top="4"
                              Width="324" Height="103"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="12" Text="Minimum distance between two corners:" />
                            <TextBox x:Name="MinCornerDistBox"
                                     Canvas.Left="204" Canvas.Top="8" Width="64" Height="21"
                                     Text="0.88"
                                     Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="274" Canvas.Top="12" Text="cm" />

                            <TextBlock Canvas.Left="8" Canvas.Top="36" Text="Minimum angle:" />
                            <TextBox Canvas.Left="204" Canvas.Top="32" Width="64" Height="21"
                                     Text="22.5"
                                     Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="274" Canvas.Top="36" Text="degrees" />

                            <CheckBox Canvas.Left="8" Canvas.Top="64"
                                      Content="set corners as graded points"
                                      IsChecked="True" />
                        </Canvas>
                    </GroupBox>

                    <!-- Interpolation settings -->
                    <GroupBox Header="Interpolation settings"
                              Canvas.Left="5" Canvas.Top="111"
                              Width="324" Height="46"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="10" Text="Maximum deviation:" />
                            <TextBox Canvas.Left="110" Canvas.Top="6" Width="64" Height="21"
                                     Text="0.1"
                                     Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="180" Canvas.Top="10" Text="cm" />
                        </Canvas>
                    </GroupBox>

                    <!-- Curve to line parameter -->
                    <GroupBox Header="Curve to line parameter"
                              Canvas.Left="5" Canvas.Top="161"
                              Width="324" Height="68"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <CheckBox Canvas.Left="8" Canvas.Top="8"
                                      Content="Convert curves to lines" />
                            <TextBlock Canvas.Left="8" Canvas.Top="34" Text="Approximation:" />
                            <TextBox Canvas.Left="88" Canvas.Top="30" Width="41" Height="21"
                                     Text="0.2"
                                     Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="136" Canvas.Top="34" Text="cm" />
                        </Canvas>
                    </GroupBox>

                    <!-- Internal Points -->
                    <GroupBox Header="Internal Points"
                              Canvas.Left="5" Canvas.Top="233"
                              Width="324" Height="46"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="10" Text="Internal point length:" />
                            <Slider Canvas.Left="158" Canvas.Top="8"
                                    Width="128" Height="18"
                                    Minimum="3" Maximum="9" Value="6" />
                        </Canvas>
                    </GroupBox>

                    <!-- Smart functions: -->
                    <GroupBox Header="Smart functions:"
                              Canvas.Left="336" Canvas.Top="4"
                              Width="180" Height="82"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <CheckBox Canvas.Left="8" Canvas.Top="8" Content="Autodetect notches" IsChecked="True" />
                            <CheckBox Canvas.Left="8" Canvas.Top="28" Content="Autodetect internal lines" />
                            <CheckBox Canvas.Left="8" Canvas.Top="48" Content="Autodetect internal points" IsEnabled="False" />
                        </Canvas>
                    </GroupBox>

                    <!-- Notches -->
                    <GroupBox Header="Notches"
                              Canvas.Left="336" Canvas.Top="90"
                              Width="180" Height="189"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <CheckBox Canvas.Left="8" Canvas.Top="8" Content="Force notches to 90 degrees" />
                            <TextBlock Canvas.Left="8" Canvas.Top="32" Text="If angle under:" />
                            <TextBox Canvas.Left="16" Canvas.Top="50" Width="56" Height="21"
                                     Text="20" IsEnabled="False"
                                     Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="78" Canvas.Top="54" Text="degrees" />

                            <CheckBox Canvas.Left="8" Canvas.Top="82" Content="Auto detect notches length:" IsChecked="True" />
                            <TextBlock Canvas.Left="8" Canvas.Top="106" Text="Default notch length:" />
                            <TextBox Canvas.Left="16" Canvas.Top="124" Width="56" Height="21"
                                     Text="1.5" IsEnabled="False"
                                     Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="78" Canvas.Top="128" Text="cm" />
                        </Canvas>
                    </GroupBox>
                </Canvas>
            </TabItem>

            <!-- TAB 3: Interface settings -->
            <TabItem Header="Interface settings" Padding="4,2">
                <Canvas Background="#F0F0F0">
                    <TextBlock Canvas.Left="10" Canvas.Top="10" Text="Selected elements color" />
                    <Border Canvas.Left="168" Canvas.Top="8" Width="17" Height="17" Background="#FF0000" BorderBrush="#000000" BorderThickness="1" />

                    <TextBlock Canvas.Left="10" Canvas.Top="31" Text="Contur color" />
                    <Border Canvas.Left="168" Canvas.Top="29" Width="17" Height="17" Background="#008000" BorderBrush="#000000" BorderThickness="1" />

                    <TextBlock Canvas.Left="10" Canvas.Top="52" Text="Graded points color" />
                    <Border Canvas.Left="168" Canvas.Top="50" Width="17" Height="17" Background="#FF0000" BorderBrush="#000000" BorderThickness="1" />

                    <TextBlock Canvas.Left="10" Canvas.Top="73" Text="Curve points color" />
                    <Border Canvas.Left="168" Canvas.Top="71" Width="17" Height="17" Background="#0000FF" BorderBrush="#000000" BorderThickness="1" />

                    <TextBlock Canvas.Left="10" Canvas.Top="94" Text="Notches color" />
                    <Border Canvas.Left="168" Canvas.Top="92" Width="17" Height="17" Background="#000080" BorderBrush="#000000" BorderThickness="1" />

                    <TextBlock Canvas.Left="10" Canvas.Top="115" Text="Internal points color" />
                    <Border Canvas.Left="168" Canvas.Top="113" Width="17" Height="17" Background="#800080" BorderBrush="#000000" BorderThickness="1" />

                    <TextBlock Canvas.Left="10" Canvas.Top="136" Text="Internal lines color" />
                    <Border Canvas.Left="168" Canvas.Top="134" Width="17" Height="17" Background="#008080" BorderBrush="#000000" BorderThickness="1" />

                    <GroupBox Header="Cursor color"
                              Canvas.Left="330" Canvas.Top="8"
                              Width="180" Height="73"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <RadioButton Canvas.Left="10" Canvas.Top="10" Content="Black cursors" IsChecked="True" GroupName="CurCol" />
                            <RadioButton Canvas.Left="10" Canvas.Top="32" Content="White cursors" GroupName="CurCol" />
                        </Canvas>
                    </GroupBox>

                    <CheckBox Canvas.Left="10" Canvas.Top="254" Content="Line width by zoom" />
                    <Button Canvas.Left="435" Canvas.Top="250" Width="75" Height="24"
                            Content="Reset Colors"
                            Style="{StaticResource GeminiClassicButtonStyle}" />
                </Canvas>
            </TabItem>

            <!-- TAB 4: Export settings -->
            <TabItem Header="Export settings" Padding="4,2">
                <Canvas Background="#F0F0F0">
                    <GroupBox Header="Investronica settings:"
                              Canvas.Left="8" Canvas.Top="6"
                              Width="282" Height="166"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="12" Text="IP:" />
                            <TextBox Canvas.Left="86" Canvas.Top="8" Width="121" Height="21" Text="127.0.0.1" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="36" Text="User:" />
                            <TextBox Canvas.Left="86" Canvas.Top="32" Width="121" Height="21" Text="sa" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="60" Text="Password:" />
                            <TextBox Canvas.Left="86" Canvas.Top="56" Width="121" Height="21" Text="****" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <CheckBox Canvas.Left="8" Canvas.Top="82" Content="Remote files path:" />
                            <TextBox Canvas.Left="8" Canvas.Top="100" Width="196" Height="21" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <Button Canvas.Left="210" Canvas.Top="98" Width="58" Height="24" Content="Browse" Style="{StaticResource GeminiClassicButtonStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="130" Text="Interpolation Precision :" />
                            <TextBox Canvas.Left="160" Canvas.Top="126" Width="45" Height="21" Text="0,2" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="210" Canvas.Top="130" Text="mm" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Lectra settings: "
                              Canvas.Left="296" Canvas.Top="6"
                              Width="218" Height="166"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="16" Text="Interpolation Precision :" />
                            <TextBox Canvas.Left="138" Canvas.Top="12" Width="45" Height="21" Text="0,2" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="188" Canvas.Top="16" Text="mm" />

                            <TextBlock Canvas.Left="8" Canvas.Top="44" Text="Graded point angle :" />
                            <TextBox Canvas.Left="138" Canvas.Top="40" Width="41" Height="21" Text="0" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Gerber settings:"
                              Canvas.Left="8" Canvas.Top="176"
                              Width="282" Height="98"
                              BorderBrush="#D0D0D0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="16" Text="Interpolation Precision :" />
                            <TextBox Canvas.Left="160" Canvas.Top="12" Width="45" Height="21" Text="0,2" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="210" Canvas.Top="16" Text="mm" />
                        </Canvas>
                    </GroupBox>
                </Canvas>
            </TabItem>
        </TabControl>

        <!-- OK & Cancel Buttons (Left=360 & 440, Top=328, Width=75, Height=25, matches TSettingsFrm DFM) -->
        <Button x:Name="OkBtn"
                Canvas.Left="360" Canvas.Top="328"
                Width="75" Height="25"
                Content="OK"
                IsDefault="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="OkBtn_Click" />
        <Button x:Name="CancelBtn"
                Canvas.Left="440" Canvas.Top="328"
                Width="75" Height="25"
                Content="Cancel"
                IsCancel="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="CancelBtn_Click" />
    </Canvas>
</Window>
