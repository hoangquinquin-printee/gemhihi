<Window x:Class="PatternDigitizerPro.UI.Views.RegisterProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inregistrare GEMINI"
        Width="430"
        Height="134"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#DCDAD0"
        FontFamily="Tahoma, MS Sans Serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas Background="#DCDAD0">
        <TextBlock Canvas.Left="5" Canvas.Top="13"
                   Text="COD INREGISTRARE:"
                   FontWeight="Bold" />
        <TextBox Canvas.Left="5" Canvas.Top="37"
                 Width="415" Height="21"
                 FontFamily="Courier New"
                 CharacterCasing="Upper"
                 MaxLength="50"
                 Style="{StaticResource GeminiClassicTextBoxStyle}" />

        <Button Canvas.Left="255" Canvas.Top="72"
                Width="75" Height="25"
                Content="Inregistreaza"
                IsDefault="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="RegisterBtn_Click" />
        <Button Canvas.Left="345" Canvas.Top="71"
                Width="75" Height="25"
                Content="Renunta"
                IsCancel="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="CancelBtn_Click" />
    </Canvas>
</Window>
