<Window x:Class="PatternDigitizerPro.UI.Views.ExportDxfStructureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structure settings"
        Width="578"
        Height="536"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#DCDAD0"
        FontFamily="Tahoma, MS Sans Serif"
        FontSize="11"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Canvas Background="#DCDAD0">
        <!-- PCSetariExport (Left=1, Top=0, Width=569, Height=472) -->
        <TabControl x:Name="StructureTabControl"
                    Canvas.Left="1" Canvas.Top="0"
                    Width="569" Height="472"
                    Background="#DCDAD0"
                    BorderBrush="#808080">

            <!-- Tab 0: General settings -->
            <TabItem Header="General settings" Padding="4,2">
                <Canvas Background="#DCDAD0">
                    <TextBlock Canvas.Left="9" Canvas.Top="18" Text="Profile name" FontWeight="Bold" />
                    <TextBox Canvas.Left="101" Canvas.Top="14" Width="138" Height="21" Text="General" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                    <GroupBox Header="Export selection"
                              Canvas.Left="10" Canvas.Top="47"
                              Width="272" Height="106"
                              FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="16" Canvas.Top="10" Content="Text" IsChecked="True" />
                            <CheckBox Canvas.Left="16" Canvas.Top="34" Content="Notches" IsChecked="True" />
                            <CheckBox Canvas.Left="16" Canvas.Top="58" Content="Auxiliary pieces" IsChecked="True" />
                            <CheckBox Canvas.Left="150" Canvas.Top="10" Content="Drill holes" IsChecked="True" />
                            <CheckBox Canvas.Left="150" Canvas.Top="34" Content="Axis" IsChecked="True" />
                            <CheckBox Canvas.Left="150" Canvas.Top="58" Content="Symmetrized" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Seam lines"
                              Canvas.Left="298" Canvas.Top="49"
                              Width="249" Height="94"
                              FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <GroupBox Header="Export mode" Canvas.Left="8" Canvas.Top="4" Width="227" Height="64" BorderBrush="#A0A0A0">
                                <Canvas>
                                    <RadioButton Canvas.Left="8" Canvas.Top="6" Content="Separate pieces" GroupName="SeamMode" />
                                    <RadioButton Canvas.Left="8" Canvas.Top="26" Content="Internal contour" IsChecked="True" GroupName="SeamMode" />
                                </Canvas>
                            </GroupBox>
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Duplicate pieces"
                              Canvas.Left="9" Canvas.Top="158"
                              Width="287" Height="115"
                              FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <GroupBox Header="Piece multiplication on export" Canvas.Left="6" Canvas.Top="4" Width="270" Height="65" BorderBrush="#A0A0A0">
                                <Canvas>
                                    <RadioButton Canvas.Left="6" Canvas.Top="6" Content="one single piece with duplicates number attached" GroupName="DupMode" />
                                    <RadioButton Canvas.Left="6" Canvas.Top="26" Content="one piece for each duplicate" IsChecked="True" GroupName="DupMode" />
                                </Canvas>
                            </GroupBox>
                            <CheckBox Canvas.Left="12" Canvas.Top="74" Content="Add suffix for each piece variant" IsChecked="True" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Notches with grading steps"
                              Canvas.Left="304" Canvas.Top="147"
                              Width="241" Height="107"
                              FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <GroupBox Header="Notch export mode" Canvas.Left="6" Canvas.Top="6" Width="222" Height="74" BorderBrush="#A0A0A0">
                                <Canvas>
                                    <RadioButton Canvas.Left="6" Canvas.Top="4" Content="without grading steps" GroupName="NotchExp" />
                                    <RadioButton Canvas.Left="6" Canvas.Top="22" Content="transformed into axis" IsChecked="True" GroupName="NotchExp" />
                                    <RadioButton Canvas.Left="6" Canvas.Top="40" Content="not exported" GroupName="NotchExp" />
                                </Canvas>
                            </GroupBox>
                        </Canvas>
                    </GroupBox>
                </Canvas>
            </TabItem>

            <!-- Tab 1: DXF file structure settings -->
            <TabItem Header="DXF file structure settings" Padding="4,2">
                <Canvas Background="#DCDAD0">
                    <GroupBox Header="File heading settings" Canvas.Left="4" Canvas.Top="2" Width="293" Height="42" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="7" Canvas.Top="6" Content="Export heading tables" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Polyline settings" Canvas.Left="4" Canvas.Top="46" Width="293" Height="98" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="7" Canvas.Top="4" Content="Double first point for close polylines" IsChecked="True" />
                            <CheckBox Canvas.Left="7" Canvas.Top="24" Content="Close polylines through layer" />
                            <GroupBox Header="First piece contour" Canvas.Left="7" Canvas.Top="42" Width="274" Height="38" BorderBrush="#A0A0A0">
                                <Canvas>
                                    <RadioButton Canvas.Left="8" Canvas.Top="2" Content="Seam line" GroupName="FirstCont" />
                                    <RadioButton Canvas.Left="136" Canvas.Top="2" Content="Cut line" IsChecked="True" GroupName="FirstCont" />
                                </Canvas>
                            </GroupBox>
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Grain axis settings" Canvas.Left="4" Canvas.Top="146" Width="293" Height="75" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="8" Canvas.Top="4" Content="Grain axis as first element in the block" />
                            <CheckBox Canvas.Left="8" Canvas.Top="21" Content="Grade grain axis" IsChecked="True" />
                            <CheckBox Canvas.Left="8" Canvas.Top="38" Content="Double grain axis as grading axis" IsChecked="True" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="File details" Canvas.Left="4" Canvas.Top="223" Width="293" Height="98" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <RadioButton Canvas.Left="14" Canvas.Top="12" Content="Begin piece description" GroupName="PieceDet" />
                            <RadioButton Canvas.Left="14" Canvas.Top="32" Content="End piece description" IsChecked="True" GroupName="PieceDet" />
                            <CheckBox Canvas.Left="8" Canvas.Top="56" Content="Name piece description" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Other settings" Canvas.Left="4" Canvas.Top="323" Width="293" Height="116" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <TextBlock Canvas.Left="6" Canvas.Top="56" Text="Text size:" />
                            <TextBox Canvas.Left="124" Canvas.Top="52" Width="75" Height="21" Text="10.0" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                            <TextBlock Canvas.Left="6" Canvas.Top="80" Text="Grading note:" />
                            <TextBox Canvas.Left="124" Canvas.Top="76" Width="75" Height="21" Text="# " Style="{StaticResource GeminiClassicTextBoxStyle}" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Points settings" Canvas.Left="301" Canvas.Top="2" Width="253" Height="131" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="8" Canvas.Top="6" Content="Group points by their type" />
                            <CheckBox Canvas.Left="8" Canvas.Top="74" Content="Contorus without point description (DXF)" />
                            <CheckBox Canvas.Left="8" Canvas.Top="94" Content="Name points in DXF" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Notch settings" Canvas.Left="301" Canvas.Top="135" Width="253" Height="200" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="8" Canvas.Top="6" Content="Group notches" />
                            <CheckBox Canvas.Left="8" Canvas.Top="26" Content="Grade notches" />
                            <CheckBox Canvas.Left="8" Canvas.Top="84" Content="Notches before mark points" IsChecked="True" />
                            <CheckBox Canvas.Left="8" Canvas.Top="106" Content="Transform notches into lines (DXF)" />
                        </Canvas>
                    </GroupBox>

                    <GroupBox Header="Gradings" Canvas.Left="301" Canvas.Top="338" Width="253" Height="42" FontWeight="Bold" BorderBrush="#A0A0A0">
                        <Canvas TextElement.FontWeight="Normal">
                            <CheckBox Canvas.Left="8" Canvas.Top="6" Content="Reverse gradings" />
                        </Canvas>
                    </GroupBox>
                </Canvas>
            </TabItem>

            <!-- Tab 2: DXF layer settings -->
            <TabItem Header="DXF layer settings" Padding="4,2">
                <Canvas Background="#DCDAD0">
                    <GroupBox Canvas.Left="8" Canvas.Top="4" Width="356" Height="284" BorderBrush="#A0A0A0">
                        <Canvas>
                            <TextBlock Canvas.Left="8" Canvas.Top="12" Text="DXF Block" />
                            <TextBox Canvas.Left="104" Canvas.Top="8" Width="50" Height="21" Text="0" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="37" Text="Pieces contour" />
                            <TextBox Canvas.Left="104" Canvas.Top="34" Width="50" Height="21" Text="1" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="62" Text="Grading points" />
                            <TextBox Canvas.Left="104" Canvas.Top="59" Width="50" Height="21" Text="2" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="88" Text="Notches" />
                            <TextBox Canvas.Left="104" Canvas.Top="85" Width="50" Height="21" Text="4" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="113" Text="Curve points" />
                            <TextBox Canvas.Left="104" Canvas.Top="110" Width="50" Height="21" Text="3" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="139" Text="Drill holes" />
                            <TextBox Canvas.Left="104" Canvas.Top="136" Width="50" Height="21" Text="13" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="194" Canvas.Top="12" Text="Seam lines" />
                            <TextBox Canvas.Left="290" Canvas.Top="8" Width="50" Height="21" Text="14" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="194" Canvas.Top="37" Text="Symmetry axis" />
                            <TextBox Canvas.Left="290" Canvas.Top="34" Width="50" Height="21" Text="6" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="194" Canvas.Top="62" Text="Grain axis" />
                            <TextBox Canvas.Left="290" Canvas.Top="59" Width="50" Height="21" Text="7" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="194" Canvas.Top="88" Text="Text elements" />
                            <TextBox Canvas.Left="290" Canvas.Top="85" Width="50" Height="21" Text="8" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="194" Canvas.Top="113" Text="Grade lines" />
                            <TextBox Canvas.Left="290" Canvas.Top="110" Width="50" Height="21" Text="5" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="194" Canvas.Top="139" Text="Notch width" />
                            <TextBox Canvas.Left="290" Canvas.Top="136" Width="50" Height="21" Text="39" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="173" Text="Internal lines" />
                            <TextBox Canvas.Left="168" Canvas.Top="170" Width="50" Height="21" Text="8" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="198" Text="Internal lines for cutting" />
                            <TextBox Canvas.Left="168" Canvas.Top="195" Width="50" Height="21" Text="11" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="222" Text="Internal pieces for drawing" />
                            <TextBox Canvas.Left="168" Canvas.Top="219" Width="50" Height="21" Text="8" Style="{StaticResource GeminiClassicTextBoxStyle}" />

                            <TextBlock Canvas.Left="8" Canvas.Top="247" Text="Internal pieces for cutting" />
                            <TextBox Canvas.Left="168" Canvas.Top="244" Width="50" Height="21" Text="11" Style="{StaticResource GeminiClassicTextBoxStyle}" />
                        </Canvas>
                    </GroupBox>
                </Canvas>
            </TabItem>
        </TabControl>

        <!-- Bottom Buttons: Default settings, Ok, Cancel -->
        <Button Canvas.Left="1" Canvas.Top="476" Width="87" Height="25"
                Content="Default settings"
                Style="{StaticResource GeminiClassicButtonStyle}" />

        <Button Canvas.Left="405" Canvas.Top="476" Width="78" Height="25"
                Content="Ok"
                IsDefault="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="OkBtn_Click" />

        <Button Canvas.Left="492" Canvas.Top="476" Width="78" Height="25"
                Content="Cancel"
                IsCancel="True"
                Style="{StaticResource GeminiClassicButtonStyle}"
                Click="CancelBtn_Click" />
    </Canvas>
</Window>
